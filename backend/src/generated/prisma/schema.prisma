generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  sightings Sighting[]
  createdAt DateTime   @default(now())
}

model Sighting {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  lat         Float
  lng         Float
  date        DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
